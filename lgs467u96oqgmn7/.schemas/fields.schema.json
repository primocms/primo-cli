{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Pala Block Fields Schema",
	"description": "Schema for Pala CMS block field definitions",
	"type": "object",
	"required": ["id", "name", "fields"],
	"properties": {
		"id": {
			"type": "string",
			"description": "Unique identifier for the block"
		},
		"name": {
			"type": "string",
			"description": "Display name for the block"
		},
		"fields": {
			"type": "array",
			"description": "Array of field definitions",
			"items": {
				"type": "object",
				"required": ["id", "name", "type"],
				"properties": {
					"id": {
						"type": "string",
						"description": "Unique identifier for the field within this block"
					},
					"name": {
						"type": "string",
						"description": "Field name used as variable in component"
					},
					"label": {
						"type": "string",
						"description": "Label shown in CMS editor (required for all types except 'info')"
					},
					"type": {
						"type": "string",
						"enum": [
							"text",
							"rich-text",
							"markdown",
							"image",
							"link",
							"url",
							"icon",
							"number",
							"switch",
							"select",
							"repeater",
							"group",
							"page",
							"page-list",
							"page-field",
							"site-field",
							"slider",
							"date",
							"info"
						],
						"description": "Field type - must be one of the valid types"
					},
					"options": {
						"description": "Field-specific options (required for select fields, null for others)",
						"oneOf": [
							{
								"type": "null"
							},
							{
								"type": "object",
								"properties": {
									"options": {
										"type": "array",
										"description": "Array of select options (required for select type)",
										"items": {
											"type": "object",
											"required": ["label", "value", "icon"],
											"properties": {
												"label": {
													"type": "string",
													"description": "Display label for the option"
												},
												"value": {
													"type": "string",
													"description": "Value used in code"
												},
												"icon": {
													"type": "string",
													"description": "Icon for the option (can be empty string)"
												}
											},
											"additionalProperties": false
										}
									}
								},
								"additionalProperties": true
							}
						]
					},
					"parent": {
						"type": "string",
						"description": "Name of parent repeater/group field (for nested fields)"
					}
				},
				"additionalProperties": false,
				"allOf": [
					{
						"if": {
							"properties": {
								"type": {
									"const": "select"
								}
							}
						},
						"then": {
							"properties": {
								"options": {
									"type": "object",
									"required": ["options"],
									"properties": {
										"options": {
											"type": "array",
											"minItems": 1
										}
									}
								}
							},
							"required": ["options"]
						}
					},
					{
						"if": {
							"properties": {
								"type": {
									"not": {
										"const": "info"
									}
								}
							}
						},
						"then": {
							"required": ["label"]
						}
					}
				]
			}
		}
	},
	"additionalProperties": false
}
